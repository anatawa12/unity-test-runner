{
	"compilerOptions": {
		"types": ["node"],
		"target": "es2022",
		"lib": ["ES2023"],
		"module": "Node16",

		"outDir": "./lib",
		"rootDir": "./src",
		"strict": true,
		"noImplicitAny": true,
		"esModuleInterop": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "**/*.test.ts"]
}
